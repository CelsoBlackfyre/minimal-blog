{
  "providers": ["node"],
  "variables": {
    "NODE_ENV": "production"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_18"],
      "nixLibs": []
    },
    "install": {
      "cmds": [
        "npm ci"
      ]
    },
    "build": {
      "cmds": [
        "npm run build"
      ]
    }
  },
  "start": {
    "cmd": "npx serve -s dist -l 4321"
  }
}
