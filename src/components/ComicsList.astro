---
const { comics = [] } = Astro.props;
---

{comics.length === 0 ? (
  <p>No comics available.</p>
) : (
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    {comics.map((comic) => (
      <div class="bg-zinc-900 rounded p-4 shadow">
        {comic.imageUrl && (
          <img src={comic.imageUrl} alt={comic.title} class="w-full h-48 object-cover rounded mb-2" />
        )}
        <h2 class="text-lg font-bold">{comic.title}</h2>
        <a href={comic.url} class="text-blue-400 hover:underline" target="_blank">
          View Comic →
        </a>
      </div>
    ))}
  </div>
)}
