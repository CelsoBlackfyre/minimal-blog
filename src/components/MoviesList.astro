---
import { getMovies } from '../utils/fetch-movies';

interface Movie {
  id: number;
  title: string;
  poster_path: string | null;
  release_date: string;
  vote_average: number;
  overview: string;
}

// If no movies are passed as props, fetch them directly
let { movies = [] } = Astro.props as { movies?: Movie[] };

if (!movies.length) {
  try {
    const data = await getMovies();
    movies = data?.results || [];
  } catch (error) {
    console.error('Failed to fetch movies:', error);
    movies = [];
  }
}

const getPosterUrl = (path: string | null) => {
  if (!path) return '/placeholder-movie.jpg';
  return `https://image.tmdb.org/t/p/w500${path}`;
};
---

<div class="movies-container">
  {movies.length > 0 ? (
    <div class="movies-grid">
      {movies.map((movie) => (
        <article class="movie-card">
          <div class="movie-poster">
            <img 
              src={getPosterUrl(movie.poster_path)} 
              alt={`${movie.title} poster`}
              loading="lazy"
              width="342"
              height="513"
              class="poster-image"
            />
            <div class="movie-rating">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="star-icon">
                <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
              </svg>
              <span>{movie.vote_average.toFixed(1)}</span>
            </div>
          </div>
          <div class="movie-info">
            <h3 class="movie-title">{movie.title}</h3>
            <div class="movie-meta">
              <span class="movie-year">{new Date(movie.release_date).getFullYear()}</span>
            </div>
            <p class="movie-overview">
              {movie.overview || 'No overview available.'}
            </p>
            <a 
              href={`https://www.themoviedb.org/movie/${movie.id}`} 
              target="_blank" 
              rel="noopener noreferrer"
              class="movie-link"
            >
              View Details
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="no-movies">
      <p>No movies found. Please try again later.</p>
    </div>
  )}
</div>

<style>
  .movies-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
    padding: 1rem 0;
  }

  .movie-card {
    background: var(--card-bg);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .movie-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }

  .movie-poster {
    position: relative;
    padding-top: 150%;
    background: #f0f0f0;
    overflow: hidden;
  }

  .poster-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .movie-card:hover .poster-image {
    transform: scale(1.05);
  }

  .movie-rating {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    display: flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .star-icon {
    width: 1rem;
    height: 1rem;
    margin-right: 0.25rem;
    color: #fbbf24;
  }

  .movie-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .movie-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: slategray;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .movie-meta {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
    color: white;
    font-size: 0.875rem;
  }

  .movie-year {
    display: flex;
    align-items: center;
  }

  .movie-overview {
    color: whitesmoke;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 1rem 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .movie-link {
    display: inline-flex;
    align-items: center;
    color: darkred;
    font-weight: 500;
    font-size: 0.875rem;
    text-decoration: none;
    margin-top: auto;
    transition: color 0.2s ease;
  }

  .movie-link:hover {
    color: red;
    text-decoration: underline;
  }

  .movie-link svg {
    width: 1rem;
    height: 1rem;
    margin-left: 0.5rem;
    transition: transform 0.2s ease;
  }

  .movie-link:hover svg {
    transform: translateX(2px);
  }

  .no-movies {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .movies-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .movies-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 1rem;
    }
    
    .movie-info {
      padding: 1rem;
    }
    
    .movie-title {
      font-size: 1rem;
    }
    
    .movie-overview {
      display: none;
    }
  }
</style>
<style>
  #movies-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .notice {
    background: #1a1a1a;
    border-left: 4px solid #ffc107;
    padding: 2rem;
    border-radius: 4px;
    text-align: center;
    color: #fff;
    box-shadow: 0 4px 24px #7f1d1d22;
  }
</style>
