---
import { getMovies } from "../utils/fetch-movies";

interface Movie {
  id: number;
  title: string;
  poster_path?: string;
  [key: string]: any;
}

// Get initial data at build time
const initialMovies: Movie[] = await getMovies();
---

<div id="movies-container">
  <div id="loading" style="display: none;">Loading movies...</div>
  
  {initialMovies.length === 0 ? (
    <div id="no-movies">
      <p>No movies available at the moment. Please check back later.</p>
    </div>
  ) : (
    <div id="movies-wall" class="movies-wall">
      {initialMovies.map((movie) => (
        <div class="movie-card">
          {movie.poster_path && (
            <img 
              src={"https://image.tmdb.org/t/p/w500" + movie.poster_path} 
              alt={movie.title} 
              loading="lazy"
            />
          )}
          <div class="movie-info">
            <h3>{movie.title}</h3>
            <a 
              href={"https://www.themoviedb.org/movie/" + movie.id} 
              target="_blank" 
              rel="noopener noreferrer"
              class="view-movie"
            >
              View Movie →
            </a>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<script>
  // Define the Movie interface for TypeScript in the client-side script
  interface Movie {
    id: number;
    title: string;
    poster_path?: string;
    [key: string]: any;
  }

  // Client-side hydration
  document.addEventListener('astro:page-load', async () => {
    const container = document.getElementById('movies-container');
    const loading = document.getElementById('loading');
    const noMovies = document.getElementById('no-movies');
    const moviesWall = document.getElementById('movies-wall');
    
    // Type guard to ensure elements exist
    if (!loading || !noMovies || !moviesWall) {
      console.error('Required elements not found');
      return;
    }

    try {
      loading.style.display = 'block';
      noMovies.style.display = 'none';
      
      // Re-fetch movies on the client side
      const response = await fetch('/api/movies');
      if (!response.ok) throw new Error('Failed to fetch movies');
      
      const movies: Movie[] = await response.json();
      
      if (movies.length === 0) {
        noMovies.style.display = 'block';
        moviesWall.style.display = 'none';
      } else {
        noMovies.style.display = 'none';
        // Clear existing content
        moviesWall.innerHTML = '';
        // Add new movies
        movies.forEach((movie) => {
          const movieCard = document.createElement('div');
          movieCard.className = 'movie-card';
          movieCard.innerHTML = `
            ${movie.poster_path ? `
              <img 
                src="https://image.tmdb.org/t/p/w500${movie.poster_path}" 
                alt="${movie.title}" 
                loading="lazy"
              />
            ` : ''}
            <div class="movie-info">
              <h3>${movie.title}</h3>
              <a 
                href="https://www.themoviedb.org/movie/${movie.id}" 
                target="_blank" 
                rel="noopener noreferrer"
                class="view-movie"
              >
                View Movie →
              </a>
            </div>
          `;
          moviesWall.appendChild(movieCard);
        });
      }
    } catch (error) {
      console.error('Error loading movies:', error);
      noMovies.innerHTML = '<p>Error loading movies. Please try again later.</p>';
      noMovies.style.display = 'block';
    } finally {
      loading.style.display = 'none';
    }
  });
</script>

<style>
.movies-wall {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 2rem;
  padding: 2rem 0;
  width: 100%;
  max-width: 1300px;
  margin: 0 auto;
}

.movie-card {
  background: rgba(20, 10, 10, 0.86);
  border-radius: 18px;
  box-shadow: 0 6px 32px 0 rgba(80,10,20,0.15), 0 1.5px 10px 0 rgba(127,29,29,0.11) inset;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.16s cubic-bezier(.28,.84,.42,1);
  border: 1.5px solid rgba(127,29,29,0.14);
}
.movie-card:hover {
  transform: translateY(-8px) scale(1.035);
  box-shadow: 0 10px 40px 0 #7f1d1d44, 0 1.5px 18px 0 #7f1d1d22 inset;
  border-color: #7f1d1d44;
}

.movie-card img {
  width: 100%;
  aspect-ratio: 2/3;
  object-fit: cover;
  border-radius: 16px 16px 0 0;
  transition: filter 0.2s;
  filter: grayscale(10%) contrast(1.1);
  box-shadow: 0 2px 12px #000a;
}
.movie-card:hover img {
  filter: grayscale(0) contrast(1.1) brightness(1.07) drop-shadow(0 0 12px #7f1d1d55);
}

.movie-info {
  padding: 1.2rem 1rem 1rem 1rem;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.movie-info h3 {
  margin: 0 0 0.5em 0;
  font-size: 1.08rem;
  color: #f8fafc;
  letter-spacing: 0.02em;
  text-shadow: 0 1px 12px #2e010166;
}

.movie-info a {
  margin-top: 0.4em;
  color: #f87171;
  text-decoration: none;
  font-size: 1em;
  font-weight: 500;
  letter-spacing: 0.02em;
  transition: color 0.17s;
}

.movie-info a:hover {
  color: #e11d48;
  text-shadow: 0 0 6px #f871713a;
}
</style>
