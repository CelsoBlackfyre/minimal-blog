---
import type { Movie, MoviesResponse } from '../utils/fetch-movies';
import { getMovies } from '../utils/fetch-movies';

// Get initial data at build time
const initialData = await getMovies();
const initialMovies = initialData.results || [];
---

<div id="movies-container">
  <div id="loading" style="display: none;">Loading movies, please wait...</div>
  
  {initialMovies.length === 0 ? (
    <div id="no-movies">
      <p>No movies available at the moment. Please check back later.</p>
    </div>
  ) : (
    <div id="movies-wall" class="movies-wall">
      {initialMovies.map((movie) => (
        <div class="movie-card">
          {movie.poster_path && (
            <img 
              src={"https://image.tmdb.org/t/p/w500" + movie.poster_path} 
              alt={movie.title} 
              loading="lazy"
              width="300"
              height="450"
            />
          )}
          <div class="movie-info">
            <h3>{movie.title}</h3>
            {movie.vote_average && (
              <div class="rating">
                ⭐ {movie.vote_average.toFixed(1)}/10
              </div>
            )}
            <a 
              href={"https://www.themoviedb.org/movie/" + movie.id} 
              target="_blank" 
              rel="noopener noreferrer"
              class="view-movie"
            >
              View Details →
            </a>
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<script>
  // Client-side hydration
  document.addEventListener('astro:page-load', async () => {
    const container = document.getElementById('movies-container');
    const loading = document.getElementById('loading');
    const noMovies = document.getElementById('no-movies');
    const moviesWall = document.getElementById('movies-wall');
    
    // Type guard to ensure elements exist
    if (!loading || !noMovies || !moviesWall) {
      console.error('Required elements not found');
      return;
    }

    try {
      loading.style.display = 'block';
      noMovies.style.display = 'none';
      
      // Re-fetch movies on the client side
      const response = await fetch('/api/movies');
      if (!response.ok) throw new Error('Failed to fetch movies');
      
      const data = await response.json();
      const movies = data.results || [];
      
      if (movies.length === 0) {
        noMovies.style.display = 'block';
        moviesWall.style.display = 'none';
      } else {
        noMovies.style.display = 'none';
        // Clear existing content
        moviesWall.innerHTML = '';
        // Add new movies
        movies.forEach((movie) => {
          const movieCard = document.createElement('div');
          movieCard.className = 'movie-card';
          
          const ratingHtml = movie.vote_average ? `
            <div class="rating">
              ⭐ ${movie.vote_average.toFixed(1)}/10
            </div>
          ` : '';
          
          movieCard.innerHTML = `
            ${movie.poster_path ? `
              <img 
                src="https://image.tmdb.org/t/p/w500${movie.poster_path}" 
                alt="${movie.title}" 
                loading="lazy"
                width="300"
                height="450"
              />
            ` : ''}
            <div class="movie-info">
              <h3>${movie.title}</h3>
              ${ratingHtml}
              <a 
                href="https://www.themoviedb.org/movie/${movie.id}" 
                target="_blank" 
                rel="noopener noreferrer"
                class="view-movie"
              >
                View Details →
              </a>
            </div>
          `;
          moviesWall.appendChild(movieCard);
        });
      }
    } catch (error) {
      console.error('Error loading movies:', error);
      if (noMovies) {
        noMovies.innerHTML = '<p>Error loading movies. Please try again later.</p>';
        noMovies.style.display = 'block';
      }
    } finally {
      if (loading) loading.style.display = 'none';
    }
  });
</script>

<style>
.movies-wall {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2rem;
  padding: 2rem 1.5rem;
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  justify-items: center;
}

.no-movies {
  grid-column: 1 / -1;
  text-align: center;
  padding: 3rem 1rem;
  color: #888;
  font-size: 1.1rem;
}

.movie-card {
  background: rgba(20, 10, 10, 0.86);
  border-radius: 12px;
  box-shadow: 0 6px 32px 0 rgba(80,10,20,0.15), 0 1.5px 10px 0 rgba(127,29,29,0.11) inset;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 280px;
  transition: all 0.3s ease;
  border: 1px solid rgba(127,29,29,0.2);
  height: 100%;
  
  &:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
    border-color: rgba(127, 29, 29, 0.4);
  }
}
.movie-card:hover {
  transform: translateY(-8px) scale(1.035);
  box-shadow: 0 10px 40px 0 #7f1d1d44, 0 1.5px 18px 0 #7f1d1d22 inset;
  border-color: #7f1d1d44;
}

.movie-card img {
  width: 100%;
  height: 330px;
  object-fit: cover;
  display: block;
  background: #1a1a1a;
  border-radius: 16px 16px 0 0;
  transition: filter 0.2s;
  filter: grayscale(10%) contrast(1.1);
  box-shadow: 0 2px 12px #000a;
}
.movie-card:hover img {
  filter: grayscale(0) contrast(1.1) brightness(1.07) drop-shadow(0 0 12px #7f1d1d55);
}

.movie-info {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  width: 100%;
  box-sizing: border-box;
}

.movie-info h3 {
  margin: 0 0 0.5rem 0;
  font-size: 1.1rem;
  font-weight: 600;
  line-height: 1.3;
  color: #f0f0f0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 3em;
}

.release-date {
  color: #aaa;
  font-size: 0.9rem;
  margin: 0 0 0.5rem 0;
}

.rating {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 215, 0, 0.15);
  color: #ffd700;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.85rem;
  margin-bottom: 1rem;
  width: fit-content;
  font-weight: 500;
}

.rating svg {
  margin-right: 0.25rem;
}

.movie-info .view-movie {
  color: #ff4d4d;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  margin-top: auto;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 77, 77, 0.2);
  transition: color 0.2s ease;
}

.movie-info .view-movie:hover {
  color: #ff6b6b;
  text-decoration: none;
}

.movie-info .view-movie::after {
  content: '→';
  margin-left: 0.5rem;
  transition: transform 0.2s ease;
}

.movie-info .view-movie:hover::after {
  transform: translateX(3px);
}
</style>
