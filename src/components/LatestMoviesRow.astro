---
import { getMovies } from "../utils/fetch-movies";
const moviesResponse = await getMovies();
const recentMovies = moviesResponse.results.slice(0, 6);
---

<div class="latest-movies-row">
    <h2>Latest Movies</h2>
    <div class="movie-cards-row">
       {recentMovies.map((movie) => (
        <div class="movie-card">
            <img src={"https://image.tmdb.org/t/p/w500" + movie.poster_path} alt={movie.title} />
            <h3>{movie.title}</h3>
            {movie.vote_average && (
              <div class="rating">
                ⭐ {movie.vote_average.toFixed(1)}/10
              </div>
            )}
            <a 
              href={"https://www.themoviedb.org/movie/" + movie.id} 
              target="_blank"
              rel="noopener noreferrer"
              class="view-movie"
            >
              View Details →
            </a>
        </div>
       ))}
    </div>
</div>

<style>
    .latest-movies-row {
        margin-bottom: 2em;
    }
    .latest-movies-row h2 {
        text-align: center;
    }
    .movie-cards-row {
        display: flex;
        gap: 1em;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .movie-card {
        flex-direction: column;
        min-width: 150px;
        background: #1e1e1e;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 5%);
        display: flex;
        align-items: center;
        text-decoration: none;
        color:inherit;
        transition: all 0.12s;
    }
    .movie-card:hover {
        transform: translateY(-4px) scale(1.04);
    }
    .movie-card img {
        width: 100%;
        height: 225px;
        object-fit: cover;
    }
    .movie-card h3 {
        font-size: 0.9rem;
        padding: 0.75rem 0.5rem 0.5rem;
        font-weight: 600;
        text-align: center;
        margin: 0;
        line-height: 1.3;
        min-height: 3.6em;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .rating {
        display: inline-flex;
        align-items: center;
        background: rgba(255, 215, 0, 0.15);
        color: #ffd700;
        padding: 0.15rem 0.5rem;
        border-radius: 12px;
        font-size: 0.75rem;
        margin: 0.25rem 0 0.75rem;
        font-weight: 500;
    }
    
    .view-movie {
        margin-top: auto;
        margin-bottom: 1rem;
        color: #ff4d4d;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        transition: all 0.2s ease;
    }
    
    .view-movie:hover {
        color: #ff6b6b;
        background: rgba(255, 77, 77, 0.1);
    }
</style>