---
import { getMovies } from "../utils/fetch-movies";
const movies = await getMovies();
const recentMovies = movies.slice(0,6);
---

<div class="latest-movies-row">
    <h2>Latest Movies</h2>
    <div class="movie-cards-row">
       {recentMovies.map((movie) => (
        <div class="movie-card">
            <img src={"https://image.tmdb.org/t/p/w500" + movie.poster_path} alt={movie.title} />
            <h2>{movie.title}</h2>
            <a href={"https://www.themoviedb.org/movie/" + movie.id} target="_blank">View Movie →</a>
        </div>
       ))}
    </div>
</div>

<style>
    .latest-movies-row {
        margin-bottom: 2em;
    }
    .latest-movies-row h2 {
        text-align: center;
    }
    .movie-cards-row {
        display: flex;
        gap: 1em;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .movie-card {
        flex-direction: column;
        min-width: 150px;
        background: #1e1e1e;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 5%);
        display: flex;
        align-items: center;
        text-decoration: none;
        color:inherit;
        transition: all 0.12s;
    }
    .movie-card:hover {
        transform: translateY(-4px) scale(1.04);
    }
    .movie-card img {
        width: 100%;
        height: 225px;
        object-fit: cover;
    }
    .movie-card h2 {
        font-size: 1rem;
        padding: 0.5rem;
        font-weight: bold;
        text-align: center;
        min-height: 2.4em;    
    }
</style>