<script>
  const backToTop = document.getElementById('back-to-top')

  function toggleBackToTop() {
    if (window.scrollY > 20) {
      backToTop.classList.remove('opacity-0', 'invisible')
      backToTop.classList.add('visible')
    } else {
      backToTop.classList.add('opacity-0', 'invisible')
      backToTop.classList.remove('visible')
    }
  }

  function scrollToTop() {
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    })
  }

  window.addEventListener('scroll', toggleBackToTop)
  backToTop?.addEventListener('click', scrollToTop)
</script>

<button id="back-to-top">
  <span>Back to top</span>
  <img src="/backToTop1.png" alt="Back to top" />
</button>

<style>
  #back-to-top {
    position: fixed;
    right: 2rem;
    bottom: 2rem;
    z-index: 9999;
    background: transparent;
    border: none;
    border-radius: 50%;
    padding: 0.5rem 0.5rem 0.25rem 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0.3s;
    cursor: pointer;
  }
  #back-to-top.visible {
    opacity: 1;
    visibility: visible;
  }
  #back-to-top img {
    width: 100px;
s    margin-bottom: 0.25rem;
    display: block;
  }
  #back-to-top span {
    color: white;
    font-size: 0.8rem;
    font-weight: bold;
    text-shadow: 0 1px 2px #000;
    letter-spacing: 1px;
  }
  #back-to-top:hover {
    background: rgba(127, 29, 29, 0.8); /* Dark red, echoes the Blackfyre palette */
  }
</style>
