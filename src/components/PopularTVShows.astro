---
// This component is client-side only
// It will be hydrated on the client side
---

<div id="popular-tv-shows" class="latest-popularTVShows-row">
  <h2>Loading Popular TV Shows...</h2>
  <div class="popularTVShows-cards-row" id="tv-shows-container">
    <!-- Content will be populated by client-side JavaScript -->
  </div>
</div>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', async () => {
    const container = document.getElementById('tv-shows-container');
    if (!container) return;

    try {
      // Fetch TV shows from our API
      const response = await fetch('/api/tvshows');
      if (!response.ok) {
        throw new Error('Failed to fetch TV shows');
      }
      
      const tvshows = await response.json();
      const popularTVShows = Array.isArray(tvshows) ? tvshows.slice(0, 6) : [];
      
      // Clear loading message
      container.innerHTML = '';
      
      // Add TV show cards to the container
      popularTVShows.forEach(tvshow => {
        const card = document.createElement('div');
        card.className = 'popularTVShows-card';
        
        const img = tvshow.poster_path 
          ? `<img 
               src="https://image.tmdb.org/t/p/w500${tvshow.poster_path}" 
               alt="${tvshow.name}"
               loading="lazy"
               width="150"
               height="225"
             />`
          : `<div class="placeholder-poster">
               <span>${tvshow.name}</span>
             </div>`;
        
        card.innerHTML = `
          ${img}
          <h3>${tvshow.name}</h3>
          <a href="https://www.themoviedb.org/tv/${tvshow.id}" target="_blank">View TV Show →</a>
        `;
        
        container.appendChild(card);
      });
      
      // Update the title to remove loading state
      const title = document.querySelector('#popular-tv-shows h2');
      if (title) {
        title.textContent = 'Popular TV Shows';
      }
      
    } catch (error) {
      console.error('Error loading TV shows:', error);
      container.innerHTML = `
        <div class="error-message">
          Failed to load TV shows. Please try again later.
        </div>
      `;
    }
  });
</script>

<style>
    .latest-popularTVShows-row {
        margin-bottom: 2em;
    }
    .latest-popularTVShows-row h2 {
        text-align: center;
    }
    .popularTVShows-cards-row {
        display: flex;
        gap: 1em;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .popularTVShows-card {
        flex-direction: column;
        min-width: 150px;
        background: #1e1e1e;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 5%);
        display: flex;
        align-items: center;
        text-decoration: none;
        color:inherit;
        transition: all 0.12s;
    }
    .popularTVShows-card:hover {
        transform: translateY(-4px) scale(1.04);
    }
    .popularTVShows-card img {
        width: 100%;
        height: 225px;
        object-fit: cover;
    }
    .popularTVShows-card h2 {
        font-size: 1rem;
        padding: 0.5rem;
        font-weight: bold;
        text-align: center;
        min-height: 2.4em;    
    }
</style>