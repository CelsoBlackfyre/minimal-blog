---
// Server-side props
interface Props {
  tvshows?: Array<{
    id: number;
    name: string;
    poster_path: string | null;
    overview: string;
    first_air_date: string;
    vote_average: number;
  }>;
}

const { tvshows = [] } = Astro.props;
const popularTVShows = tvshows.slice(0, 6);
---

<div id="popular-tv-shows" class="latest-popularTVShows-row">
  <h2>Popular TV Shows</h2>
  <div class="popularTVShows-cards-row">
    {popularTVShows.length > 0 ? (
      popularTVShows.map(tvshow => (
        <div class="popularTVShows-card">
          {tvshow.poster_path ? (
            <img 
              src={`https://image.tmdb.org/t/p/w500${tvshow.poster_path}`}
              alt={tvshow.name}
              loading="lazy"
              width="150"
              height="225"
            />
          ) : (
            <div class="placeholder-poster">
              <span>{tvshow.name}</span>
            </div>
          )}
          <h3>{tvshow.name}</h3>
          <a href={`https://www.themoviedb.org/tv/${tvshow.id}`} target="_blank" rel="noopener noreferrer">
            View TV Show →
          </a>
        </div>
      ))
    ) : (
      <p>No TV shows available at the moment.</p>
    )}
  </div>
</div>

<!-- Client-side interactivity can be added here if needed -->
<script>
  // Any client-side interactivity can be added here
  // The component is now server-rendered with static data
</script>

<style>
    .latest-popularTVShows-row {
        margin-bottom: 2em;
    }
    .latest-popularTVShows-row h2 {
        text-align: center;
    }
    .popularTVShows-cards-row {
        display: flex;
        gap: 1em;
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }
    .popularTVShows-card {
        flex-direction: column;
        min-width: 150px;
        background: #1e1e1e;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 5%);
        display: flex;
        align-items: center;
        text-decoration: none;
        color:inherit;
        transition: all 0.12s;
    }
    .popularTVShows-card:hover {
        transform: translateY(-4px) scale(1.04);
    }
    .popularTVShows-card img {
        width: 100%;
        height: 225px;
        object-fit: cover;
    }
    .popularTVShows-card h2 {
        font-size: 1rem;
        padding: 0.5rem;
        font-weight: bold;
        text-align: center;
        min-height: 2.4em;    
    }
</style>