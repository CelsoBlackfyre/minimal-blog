---
import Layout from '../layouts/BlogPost.astro';
import { getMovies } from '../utils/fetch-movies';
import { useEffect, useState } from 'react';

// Client-side component
function LatestMoviesClient({ initialMovies = [] }) {
  const [movies, setMovies] = useState(initialMovies);
  const [loading, setLoading] = useState(!initialMovies.length);
  const [error, setError] = useState(null);

  useEffect(() => {
    if (initialMovies.length > 0) return; // Skip client-side fetch if we have initial data
    
    const fetchMovies = async () => {
      try {
        const response = await fetch('/api/movies');
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        const data = await response.json();
        setMovies(data.results || []);
        setLoading(false);
      } catch (err) {
        console.error('Error fetching movies:', err);
        setError(err.message);
        setLoading(false);
      }
    };

    fetchMovies();
  }, [initialMovies]);

  if (loading) {
    return (
      <div class="flex justify-center items-center min-h-[50vh]">
        <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-red-500"></div>
      </div>
    );
  }


  if (error) {
    return (
      <div class="text-center py-12">
        <p class="text-red-500">Error loading movies: {error}</p>
      </div>
    );
  }

  return (
    <div class="movies-container">
      <div class="movies-grid">
        {movies.map((movie) => (
          <article class="movie-card">
            <div class="movie-poster">
              <img 
                src={movie.poster_path 
                  ? `https://image.tmdb.org/t/p/w500${movie.poster_path}`
                  : '/placeholder-movie.jpg'}
                alt={`${movie.title} poster`}
                loading="lazy"
                width="342"
                height="513"
                class="poster-image"
              />
              <div class="movie-rating">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="star-icon">
                  <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                </svg>
                <span>{movie.vote_average?.toFixed(1) || 'N/A'}</span>
              </div>
            </div>
            <div class="movie-info">
              <h3 class="movie-title">{movie.title}</h3>
              <div class="movie-meta">
                <span class="movie-year">
                  {movie.release_date ? new Date(movie.release_date).getFullYear() : 'N/A'}
                </span>
              </div>
              <p class="movie-overview">
                {movie.overview || 'No overview available.'}
              </p>
              <a 
                href={`https://www.themoviedb.org/movie/${movie.id}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="movie-link"
              >
                View Details
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  );
}

// Server-side data fetching for better initial load
let serverMovies = [];
try {
  const data = await getMovies();
  serverMovies = data?.results || [];
} catch (error) {
  console.error('Failed to fetch initial movies:', error);
}
---

<Layout
  title="Latest Movies"
  description="Latest movies from TMDB"
  pubDate={new Date()}
  category="Movies"
>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Latest Movies</h1>
    
    <!-- Client-side component with server-side fallback -->
    <div id="movies-client">
      <LatestMoviesClient initialMovies={serverMovies} client:load />
    </div>
    
    <!-- Server-rendered fallback (hidden when client-side JS takes over) -->
    <div id="movies-server" class="hidden">
      <div class="movies-container">
        <div class="movies-grid">
          {serverMovies.map((movie) => (
            <article class="movie-card">
              <div class="movie-poster">
                <img 
                  src={movie.poster_path 
                    ? `https://image.tmdb.org/t/p/w500${movie.poster_path}`
                    : '/placeholder-movie.jpg'}
                  alt={`${movie.title} poster`}
                  loading="lazy"
                  width="342"
                  height="513"
                  class="poster-image"
                />
                <div class="movie-rating">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="star-icon">
                    <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                  </svg>
                  <span>{movie.vote_average?.toFixed(1) || 'N/A'}</span>
                </div>
              </div>
              <div class="movie-info">
                <h3 class="movie-title">{movie.title}</h3>
                <div class="movie-meta">
                  <span class="movie-year">
                    {movie.release_date ? new Date(movie.release_date).getFullYear() : 'N/A'}
                  </span>
                </div>
                <p class="movie-overview">
                  {movie.overview || 'No overview available.'}
                </p>
                <a 
                  href={`https://www.themoviedb.org/movie/${movie.id}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="movie-link"
                >
                  View Details
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Hide server-rendered content when client-side JS takes over
  document.addEventListener('DOMContentLoaded', () => {
    const serverContent = document.getElementById('movies-server');
    if (serverContent) {
      serverContent.classList.add('hidden');
    }
  });
</script>

<style>
  .hidden { display: none; }
  
  .movies-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1rem;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
    padding: 1rem 0;
  }

  .movie-card {
    background: #1a1a1a;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .movie-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
  }

  .movie-poster {
    position: relative;
    padding-top: 150%;
    background: #2d2d2d;
    overflow: hidden;
  }

  .poster-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .movie-card:hover .poster-image {
    transform: scale(1.05);
  }

  .movie-rating {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.8);
    color: white;
    display: flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }

  .star-icon {
    width: 1rem;
    height: 1rem;
    margin-right: 0.25rem;
    color: #fbbf24;
  }

  .movie-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: #1a1a1a;
  }


  .movie-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: white;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .movie-meta {
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
    color: #a0a0a0;
    font-size: 0.875rem;
  }

  .movie-year {
    display: flex;
    align-items: center;
  }

  .movie-overview {
    color: #a0a0a0;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 1rem 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .movie-link {
    display: inline-flex;
    align-items: center;
    color: darkred;
    font-weight: 500;
    font-size: 0.875rem;
    text-decoration: none;
    margin-top: auto;
    transition: color 0.2s ease;
  }

  .movie-link:hover {
    color: red;
    text-decoration: underline;
  }

  .movie-link svg {
    width: 1rem;
    height: 1rem;
    margin-left: 0.5rem;
    transition: transform 0.2s ease;
  }

  .movie-link:hover svg {
    transform: translateX(2px);
  }

  @media (max-width: 1024px) {
    .movies-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .movies-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 1rem;
    }
    
    .movie-info {
      padding: 1rem;
    }
    
    .movie-title {
      font-size: 1rem;
    }
    
    .movie-overview {
      display: none;
    }
  }
</style>
