{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" },
    { "src": "src/pages/api/**.ts", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/api/(?<path>.+)",
      "dest": "/api/$path"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/$1"
    },
    {
      "src": "^/(?!(api|_next/.*|.*\\..*$))",
      "dest": "/index.html"
    }
  ]
}
